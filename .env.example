# HTTP port and durable SQLite metadata path for the local control-plane API.
PORT=3000
PI_CLOUD_DATABASE_PATH=./data/pi-cloud.sqlite

# JSON user/service bearer identities for the authenticated v1 API. Rotate these local
# bootstrap credentials rather than committing real values.
PI_CLOUD_API_CREDENTIALS=[{"token":"replace-with-at-least-32-random-characters","subjectId":"local-user","type":"user","displayName":"Local User"}]

# Internal dispatcher bearer used only to claim work and run recovery.
PI_CLOUD_DISPATCHER_TOKEN=replace-with-another-at-least-32-random-characters

# Base64 DER-encoded Ed25519 keys. Keep the private key in the control plane only.
# Generate a development pair with the command documented in docs/task-leases.md,
# then paste the values here for local development.
PI_CLOUD_TASK_LEASE_PRIVATE_KEY=replace-with-development-private-key
PI_CLOUD_TASK_LEASE_PUBLIC_KEY=replace-with-development-public-key
PI_CLOUD_TASK_LEASE_ISSUER=pi-cloud-control-plane
PI_CLOUD_RUNNER_AUDIENCE=runner-pool/local

# Supplied to each runner by dispatch.
PI_CLOUD_CONTROL_PLANE_URL=https://control-plane.invalid
PI_CLOUD_TASK_LEASE=replace-with-signed-short-lived-lease
PI_CLOUD_RUNNER_ID=runner-local-1
PI_CLOUD_WORKSPACE_ROOT=/tmp/pi-cloud-runner

# Set only in a local runner environment. Never commit model or GitHub credentials.
# ANTHROPIC_API_KEY=
# GITHUB_APP_ID=
# GITHUB_PRIVATE_KEY=
