{
  "name": "@pi-cloud/extension",
  "version": "0.1.0",
  "description": "Connect upstream Pi on a Mac to a self-hosted Pi Cloud runtime.",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "files": [
    "*.ts",
    "!*.test.ts"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "prebuild": "npm run build --workspace=@pi-cloud/contracts",
    "build": "tsc -p tsconfig.json",
    "precheck": "npm run build --workspace=@pi-cloud/contracts",
    "check": "tsc --noEmit -p tsconfig.json",
    "pretest": "npm run build --workspace=@pi-cloud/contracts",
    "test": "tsx --test *.test.ts"
  },
  "dependencies": {
    "@pi-cloud/contracts": "0.1.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.1"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
