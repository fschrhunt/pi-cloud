{
  "name": "@pi-cloud/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "npm run build --workspace=@pi-cloud/contracts",
    "build": "tsc -p tsconfig.json",
    "precheck": "npm run build --workspace=@pi-cloud/contracts",
    "check": "tsc --noEmit -p tsconfig.json",
    "predev": "npm run build --workspace=@pi-cloud/contracts",
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "node dist/server.js",
    "pretest": "npm run build --workspace=@pi-cloud/contracts",
    "test": "tsx --test src/**/*.test.ts"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1"
  },
  "dependencies": {
    "@pi-cloud/contracts": "0.1.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/websocket": "^11.3.0",
    "fastify": "^5.11.3",
    "zod": "^4.4.3"
  }
}
