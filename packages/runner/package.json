{
  "name": "@pi-cloud/runner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "npm run build --workspace=@pi-cloud/contracts",
    "build": "tsc -p tsconfig.json",
    "precheck": "npm run build --workspace=@pi-cloud/contracts",
    "check": "tsc --noEmit -p tsconfig.json",
    "predev": "npm run build --workspace=@pi-cloud/contracts",
    "dev": "tsx src/runner.ts",
    "start": "node dist/runner.js",
    "pretest": "npm run build --workspace=@pi-cloud/contracts",
    "test": "tsx --test src/**/*.test.ts"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.1",
    "@pi-cloud/contracts": "0.1.0",
    "ws": "^8.18.3",
    "zod": "^4.4.3"
  }
}
