# Base URL advertised to runtime containers for hosted tunnels. The Docker host alias is local-only;
# use HTTPS for a server reachable beyond this development Compose setup.
PORT=3000
PI_CLOUD_PUBLIC_BASE_URL=http://host.docker.internal:3000

# Durable SQLite metadata path for the local control-plane API.
PI_CLOUD_DATABASE_PATH=./data/pi-cloud.sqlite

# JSON user/service bearer identities for the authenticated v1 API. Rotate these local
# bootstrap credentials rather than committing real values.
PI_CLOUD_API_CREDENTIALS=[{"token":"replace-with-at-least-32-random-characters","subjectId":"local-user","type":"user","displayName":"Local User"}]

# Internal dispatcher bearer used only to claim work and run recovery.
PI_CLOUD_DISPATCHER_TOKEN=replace-with-another-at-least-32-random-characters

# Base64 DER-encoded Ed25519 keys. Keep the private key in the control plane only.
# Generate a development pair with the command documented in docs/task-leases.md,
# then paste the values here for local development.
PI_CLOUD_TASK_LEASE_PRIVATE_KEY=replace-with-development-private-key
PI_CLOUD_TASK_LEASE_PUBLIC_KEY=replace-with-development-public-key
PI_CLOUD_TASK_LEASE_ISSUER=pi-cloud-control-plane
PI_CLOUD_RUNNER_AUDIENCE=runner-pool/local

# Hosted runtime paths computed by the API for persistent workspaces and the shared Pi agent directory.
PI_CLOUD_RUNTIME_WORKSPACE_ROOT=/var/lib/pi-cloud/workspaces
PI_CLOUD_RUNTIME_AGENT_DIRECTORY=/var/lib/pi-cloud/agent

# Hosted runtime process and transport limits.
PI_CLOUD_HOSTED_LAUNCH_LIMITS={"wallTimeSeconds":3600,"idleTimeSeconds":300,"terminationGraceSeconds":5,"maxRecordBytes":65536,"maxCumulativeBytes":10000000}

# Operator-defined credential references and values held by the API. Values are sent only in the
# internal claim for a workspace that explicitly grants the matching reference.
PI_CLOUD_HOSTED_CREDENTIAL_REFERENCES=[]
PI_CLOUD_HOSTED_CREDENTIALS={}
# PI_CLOUD_HOSTED_CREDENTIAL_REFERENCES=[{"name":"provider","reference":"vault://providers/anthropic","environmentVariable":"ANTHROPIC_API_KEY"}]
# PI_CLOUD_HOSTED_CREDENTIALS={"vault://providers/anthropic":"replace-with-anthropic-key"}

# One-shot leased runner inputs (M1 checkout flow and low-level runner debugging only).
PI_CLOUD_CONTROL_PLANE_URL=http://127.0.0.1:3000
PI_CLOUD_TASK_LEASE=replace-with-signed-short-lived-lease
PI_CLOUD_RUNNER_ID=runner-local-1
PI_CLOUD_WORKSPACE_ROOT=/tmp/pi-cloud-runner

# Hosted runtime worker inputs. The worker's root authorization is independent from the API's
# computed paths and must allow the workspace root, native session root, and Pi agent root.
PI_CLOUD_HOSTED_DISPATCHER_URL=http://127.0.0.1:3000
# Compose uses this separate container-facing URL instead of loopback.
PI_CLOUD_HOSTED_CONTAINER_DISPATCHER_URL=http://host.docker.internal:3000
PI_CLOUD_HOSTED_DISPATCHER_TOKEN=replace-with-another-at-least-32-random-characters
PI_CLOUD_HOSTED_WORKSPACE_ROOTS=/var/lib/pi-cloud/workspaces
PI_CLOUD_HOSTED_SESSION_ROOTS=/var/lib/pi-cloud/workspaces
PI_CLOUD_HOSTED_AGENT_ROOTS=/var/lib/pi-cloud/agent

# Optional explicit Pi executable for the hosted worker.
# PI_CLOUD_PI_EXECUTABLE=/usr/local/bin/pi

# Hosted runtime smoke inputs. The script starts a dedicated temporary API and removes its database,
# repository checkout, and native session files on every exit.
# PI_CLOUD_SMOKE_REPOSITORY_URL=https://github.com/org/repo
# PI_CLOUD_SMOKE_REVISION=0123456789abcdef0123456789abcdef01234567
# PI_CLOUD_SMOKE_PROJECT_TRUST=untrusted
# PI_CLOUD_SMOKE_PROMPT=Reply with the exact text SMOKE_OK on a single line.
# PI_CLOUD_SMOKE_EXPECTED_MARKER=SMOKE_OK
# PI_CLOUD_SMOKE_CREDENTIAL_REFERENCE_NAMES=provider
